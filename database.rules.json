{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "sections": {
      ".read": true,
      ".write": "auth != null"
    },
    "photos": {
      ".read": true,
      ".write": "auth != null"
    },
    "dept_photos": {
      ".read": true,
      ".write": "auth != null"
    },
    "home": {
      ".read": true,
      ".write": "auth != null"
    },
    "publications": {
      ".read": true,
      ".write": "auth != null"
    },
    "projects": {
      ".read": true,
      ".write": "auth != null"
    },
    "applications": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$trackingId": {
        ".read": true,
        ".write": "auth != null || !data.exists()"
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$messageId": {
        ".write": "auth != null || !data.exists()"
      }
    },
    "business_listings_pending": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$listingId": {
        ".write": "auth != null || !data.exists()"
      }
    },
    "payments": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "activity_log": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
